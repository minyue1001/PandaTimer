{
  "expo": {
    "name": "PandaTimer",
    "slug": "panda-timer",
    "scheme": "pandatimer",
    "version": "1.0.0",
    "runtimeVersion": "1.0",
    "updates": {
      "url": "https://wheat.yueshengift.xyz/pandatimer/api/manifest",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "codeSigningCertificate": "./server/certs/certificate.pem",
      "codeSigningMetadata": {
        "keyid": "main",
        "alg": "rsa-v1_5-sha256"
      }
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.pandatimer.app",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDisplayName": "熊貓倒數",
        "NSSupportsLiveActivities": true,
        "UIBackgroundModes": [
          "location",
          "audio"
        ],
        "NSLocationWhenInUseUsageDescription": "偵測中保持 App 在背景運作，以便自動更新動態島倒數",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "偵測中保持 App 在背景運作，以便自動更新動態島倒數（只需要「使用 App 期間」）",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.pandatimer.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ],
      "@bacons/apple-targets",
      "./plugins/withAppIntents",
      "./plugins/withTelemetry",
      "./plugins/withNoEntitlements"
    ],
    "extra": {
      "telemetryKey": "4QaC9xUMnxSiRSkQSQEKU-mWWzHsPBSZ6pZar8XVEjs",
      "telemetryUrl": "https://wheat.yueshengift.xyz/pandatimer/api/telemetry",
      "configUrl": "https://wheat.yueshengift.xyz/pandatimer/api/config"
    }
  }
}
