        { "type": "decided", "result": "reject", "reason": "rejected", "minutes": 18, "acceptedAt": null, "waitSec": 3 }
      ]
    },
    {
      "name": "邀請被短暫遮住（少於 goneAfterMisses 次）不算消失；之後才真的消失",
      "steps": [[0, "INVITE_27"], [1.5, "PICKUP"], [3, "INVITE_27"], [4.5, "BLANK"], [6, "INVITE_27"], [7.5, "BLANK"], [9, "BLANK"], [10.5, "PICKUP"]],
      "expect": [
        { "type": "seen", "minutes": 27 },
        { "type": "decided", "result": "accept", "reason": "accepted", "minutes": 27, "acceptedAt": 7.5, "waitSec": 3 }
