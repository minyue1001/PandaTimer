    {
      "name": "接單後同一組（分鐘, 金額）90 秒內又出現 → dup（不算新邀請）；消失後再出現也一樣",
      "steps": [[0, "INVITE_27"], [1.5, "BLANK"], [3, "BLANK"], [27, "tick"], [30, "INVITE_27"], [31.5, "INVITE_27"], [33, "BLANK"], [34.5, "BLANK"], [36, "INVITE_27"]],
      "expect": [
        { "type": "seen", "minutes": 27 },
        { "type": "decided", "result": "accept", "reason": "timeout", "minutes": 27, "acceptedAt": 1.5, "waitSec": 25.5 },
