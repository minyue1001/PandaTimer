        { "type": "seen", "minutes": 27 },
        { "type": "decided", "result": "accept", "reason": "timeout", "minutes": 27, "acceptedAt": 2, "waitSec": 25 }
      ]
    },
    {
      "name": "逾時（ambiguousAs=reject）",
