      "expect": [
        { "type": "seen", "minutes": 18 },
        { "type": "decided", "result": "reject", "reason": "rejected", "minutes": 18, "acceptedAt": null, "waitSec": 1.5 }
      ]
    },
    {
      "name": "逾時（ambiguousAs=accept，預設）：切到別的 App、畫面靜止 → 計時器 tick 判接單",
