      "expect": [
        { "type": "seen", "minutes": 27 },
        { "type": "decided", "result": "reject", "reason": "rejected", "minutes": 27, "acceptedAt": null, "waitSec": 1.5 }
      ]
    },
    {
      "name": "拒單：回到地圖（只有「上線中」、沒有訂單卡字）→ reject",
