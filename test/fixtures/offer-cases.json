      "expect": [
        { "type": "seen", "minutes": 27 },
        { "type": "decided", "result": "accept", "reason": "accepted", "minutes": 27, "acceptedAt": 4.5, "waitSec": 3, "hit": ["前往取餐", "取餐"] }
      ]
    },
    {
      "name": "拒單：邀請消失後看到「已拒絕」→ reject（不送訊號）",
